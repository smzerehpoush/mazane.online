# Sample production config — copy next to compose.prod.yml on the server as `.env`.
# The real `.env` is never committed (gitignore); only this sample lives in the repo.
# Generate a random value with: openssl rand -hex 32

# ---- Images (built outside the server — runbook, prerequisite 2) ----
# If GHCR isn't reachable from the server, the image is transferred with
# `docker save | ssh docker load` and these same variables point at the local tag (e.g. tablo-web:v1).
TABLO_IMAGE_WEB=ghcr.io/smzerehpoush/tablo-web:latest
TABLO_IMAGE_COLLECTOR=ghcr.io/smzerehpoush/tablo-collector:latest

# ---- Web ----
# Host loopback port for local sanity checks (curl http://127.0.0.1:3300).
# Check it's free before picking it: ss -ltn | grep 3300
# Real traffic never comes through this port; the edge Caddy on the tablo-edge
# network connects directly to `tablo-web:3000` (ops/caddy-snippet.Caddyfile).
TABLO_WEB_PORT=3300

# Nothing else is left to configure inside the web container — the app is
# TanStack Start + Nitro and `PORT=3000`, `HOST=0.0.0.0`, and the Node heap
# cap are fixed in Dockerfile.web itself.
# ⚠️ If you ever change the web service's memory cap in compose.prod.yml,
# `NODE_OPTIONS=--max-old-space-size=...` in Dockerfile.web must be updated to
# match; otherwise V8 guesses its heap cap from the host's RAM and the
# OOM-killer may kill a Padelyar container instead of this process.
#
# The three variables `TABLO_REDIS_URL`, `TABLO_DATABASE_URL`, and
# `TABLO_REVALIDATE_TOKEN` are built by compose itself from this same file and
# handed to web — don't duplicate them here.

# ---- Postgres ----
POSTGRES_USER=mazane
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mazane

# ---- Content pipeline (ticket 13) ----
# Shared collector <-> web token for POST /api/revalidate-blog — required.
TABLO_REVALIDATE_TOKEN=change-me-openssl-rand-hex-32
# Assumed daily editorial pace — the divisor for the draft queue's depth in
# days (decision 16). Publishing itself is human-only via the admin panel.
TABLO_DAILY_PUBLISH_CAP=2

# ---- Admin panel (ticket 20) ----
# Panel password hash — never write the actual password here. Pick a password
# first, then:
#   cd web && npm run admin:hash-password -- '<password>'
# Copy only the output (salt:hash hex format) here; also see the runbook.
TABLO_ADMIN_PASSWORD_HASH=change-me-run-npm-admin-hash-password
# HMAC signing key for the admin panel login session — openssl rand -hex 32
TABLO_ADMIN_SESSION_SECRET=change-me-openssl-rand-hex-32

# ---- Post cover image (ticket 24) ----
# ArvanCloud object storage — S3-compatible. The real key/bucket aren't
# guessed here; the owner must create them before deploying (runbook, section
# 1.4). The endpoint is usually of the form
# https://<region>.s3.arvanstorage.ir — copy it from the Arvan panel.
TABLO_ARVAN_S3_ENDPOINT=change-me-arvan-s3-endpoint
TABLO_ARVAN_S3_REGION=default
TABLO_ARVAN_S3_BUCKET=change-me-arvan-bucket-name
TABLO_ARVAN_S3_ACCESS_KEY=change-me-arvan-access-key
TABLO_ARVAN_S3_SECRET_KEY=change-me-arvan-secret-key
# The public image URL has no variable of its own: it's built from the same
# endpoint and bucket above (`<endpoint>/<bucket>/<key>`). There is no
# separate cdn subdomain involved — owner's decision 2026-08-07, confirmed
# 2026-08-10.
