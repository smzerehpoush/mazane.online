# نمونه‌ی پیکربندی تولید — کنار compose.prod.yml روی سرور با نام ‎.env‎ کپی شود.
# ‎.env‎ واقعی هرگز کامیت نمی‌شود (gitignore)؛ فقط همین نمونه در مخزن است.
# ساخت مقدار تصادفی: openssl rand -hex 32

# ---- ایمیج‌ها (بیرون از سرور ساخته می‌شوند — رانبوک، پیش‌نیاز ۲) ----
# اگر GHCR از سرور در دسترس نبود، ایمیج با ‎docker save | ssh docker load‎
# منتقل می‌شود و همین متغیرها به تگ محلی اشاره می‌کنند (مثلاً mazane-web:v1).
MAZANE_IMAGE_WEB=ghcr.io/smzerehpoush/mazane-web:latest
MAZANE_IMAGE_COLLECTOR=ghcr.io/smzerehpoush/mazane-collector:latest

# ---- وب ----
# درگاه loopback میزبان برای راستی‌آزمایی محلی (curl http://127.0.0.1:3300).
# قبل از انتخاب، آزاد بودنش را چک کنید: ss -ltn | grep 3300
# ترافیک واقعی از این درگاه نمی‌آید؛ کدیِ لبه روی شبکه‌ی mazane-edge مستقیم به
# ‎mazane-web:3000‎ وصل می‌شود (ops/caddy-snippet.Caddyfile).
MAZANE_WEB_PORT=3300

# درون کانتینر وب چیزی برای تنظیم نمانده — اپ TanStack Start + Nitro است و
# ‎PORT=3000‎، ‎HOST=0.0.0.0‎ و سقف heap نود در خود Dockerfile.web ثابت‌اند.
# ⚠️ اگر روزی سقف حافظه‌ی سرویس web در compose.prod.yml را عوض کردید،
# ‎NODE_OPTIONS=--max-old-space-size=...‎ در Dockerfile.web هم باید با آن جفت
# شود؛ وگرنه V8 سقف heap را از رم میزبان حدس می‌زند و OOM-killer به‌جای این
# پروسه ممکن است کانتینر پادل‌یار را بکشد.
#
# سه متغیر ‎MAZANE_REDIS_URL‎، ‎MAZANE_DATABASE_URL‎ و ‎MAZANE_REVALIDATE_TOKEN‎
# را compose خودش از همین فایل می‌سازد و به وب می‌دهد — اینجا تکرارشان نکنید.

# ---- پستگرس ----
POSTGRES_USER=mazane
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mazane

# ---- خط لوله‌ی محتوا (بلیت ۱۳) ----
# توکن مشترک گردآورنده ⇄ وب برای POST /api/revalidate-blog — اجباری.
MAZANE_REVALIDATE_TOKEN=change-me-openssl-rand-hex-32
# سقف انتشار روزانه‌ی بلاگ، سمت سرور (بند ۱۳ سند معماری، تصمیم ۱۶).
MAZANE_DAILY_PUBLISH_CAP=2

# ---- پنل مدیریت (بلیت ۲۰) ----
# هش رمز پنل — هرگز خودِ رمز را اینجا ننویسید. اول رمز را انتخاب کنید، بعد:
#   cd web && npm run admin:hash-password -- '<رمز عبور>'
# فقط خروجی (فرمت salt:hash هگزادسیمال) را اینجا کپی کنید؛ رانبوک را هم ببینید.
MAZANE_ADMIN_PASSWORD_HASH=change-me-run-npm-admin-hash-password
# کلید امضای HMAC نشست ورود پنل — openssl rand -hex 32
MAZANE_ADMIN_SESSION_SECRET=change-me-openssl-rand-hex-32

# ---- عکس شاخص پست (بلیت ۲۴) ----
# فضای ابری آروان — S3-سازگار. کلید/بوکت واقعی اینجا حدس زده نشده؛ مالک باید
# قبل از استقرار بسازدشان (رانبوک، بخش ۱.۴). endpoint معمولاً به شکل
# https://<region>.s3.arvanstorage.ir است — از پنل آروان کپی شود.
MAZANE_ARVAN_S3_ENDPOINT=change-me-arvan-s3-endpoint
MAZANE_ARVAN_S3_REGION=default
MAZANE_ARVAN_S3_BUCKET=change-me-arvan-bucket-name
MAZANE_ARVAN_S3_ACCESS_KEY=change-me-arvan-access-key
MAZANE_ARVAN_S3_SECRET_KEY=change-me-arvan-secret-key
# زیردامنه‌ی خودمان که عکس از آن سرو می‌شود — نه دامنه‌ی خام انبار
# (بند طراحی تیکت ۲۴: هیچ دامنه‌ی بیگانه‌ای روی مسیر بحرانی رندر ننشیند).
# DNS/گواهی این زیردامنه پیش‌نیاز مستقل است — رانبوک، بخش ۶.
MAZANE_IMAGE_CDN_BASE_URL=https://cdn.mazane.online
