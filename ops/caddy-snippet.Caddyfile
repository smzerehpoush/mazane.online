# ops/caddy-snippet.Caddyfile — بلوک سایت tablo.gold برای کدیِ لبه‌ی پادل‌یار
#
# این فایل مستقیماً import نمی‌شود؛ محتوایش در Caddyfile زندهٔ سرور است:
#   /opt/padelyar/deploy/Caddyfile
# الگوی مبدأ پشت CDN آروان (مثل optiflow.studio): HTTP + HTTPS با tls internal.
# TLS کاربر نهایی در لبه‌ی آروان تمام می‌شود — NS کامل آروان، نه CNAME به CDN.
#
# پیش‌نیاز شبکه:
#   docker network create tablo-edge
#   docker network connect tablo-edge padelyar-caddy

# ---- tablo.gold / تابلو (پشت آروان — TLS در لبهٔ آروان) ----
http://tablo.gold, http://www.tablo.gold {
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
		}
	}
	@www host www.tablo.gold
	redir @www https://tablo.gold{uri} 308
	log {
		output file /data/tablo-logs/tablo-access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}
	reverse_proxy tablo-web:3000
}

# مبدأ HTTPS اگر آروان پروتکل مبدأ را HTTPS گذاشته باشد.
# گواهی internal — در آروان SSL مبدأ غیرسختگیرانه یا HTTP به مبدأ.
https://tablo.gold, https://www.tablo.gold {
	tls internal
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
		}
	}
	@www host www.tablo.gold
	redir @www https://tablo.gold{uri} 308
	log {
		output file /data/tablo-logs/tablo-access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}
	reverse_proxy tablo-web:3000
}

# دامنهٔ قدیمی — ریدایرکت به tablo.gold
http://mazane.online, http://www.mazane.online {
	redir https://tablo.gold{uri} 308
}
https://mazane.online, https://www.mazane.online {
	tls internal
	redir https://tablo.gold{uri} 308
}
