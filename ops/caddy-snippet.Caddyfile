# ops/caddy-snippet.Caddyfile — the tablo.gold site block for Padelyar's edge Caddy
#
# This file isn't imported directly; its content lives in the server's live Caddyfile:
#   /opt/padelyar/deploy/Caddyfile
# The origin-behind-ArvanCloud-CDN pattern (like optiflow.studio): HTTP + HTTPS with tls internal.
# End-user TLS terminates at ArvanCloud's edge — full ArvanCloud NS, not a CNAME to the CDN.
#
# Network prerequisite:
#   docker network create tablo-edge
#   docker network connect tablo-edge padelyar-caddy

# ---- tablo.gold / Tablo (behind ArvanCloud — TLS at the ArvanCloud edge) ----
http://tablo.gold, http://www.tablo.gold {
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
		}
	}
	@www host www.tablo.gold
	redir @www https://tablo.gold{uri} 308
	log {
		output file /data/tablo-logs/tablo-access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}
	reverse_proxy tablo-web:3000
}

# Origin HTTPS, in case ArvanCloud has set the origin protocol to HTTPS.
# The internal certificate — in ArvanCloud, either lenient origin SSL or HTTP to the origin.
https://tablo.gold, https://www.tablo.gold {
	tls internal
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
		}
	}
	@www host www.tablo.gold
	redir @www https://tablo.gold{uri} 308
	log {
		output file /data/tablo-logs/tablo-access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}
	reverse_proxy tablo-web:3000
}

# Old domain — redirect to tablo.gold
http://mazane.online, http://www.mazane.online {
	redir https://tablo.gold{uri} 308
}
https://mazane.online, https://www.mazane.online {
	tls internal
	redir https://tablo.gold{uri} 308
}
