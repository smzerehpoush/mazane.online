# Dockerfile.web — ایمیج تولید لایه‌ی وب (بلیت ۱۱)
#
# (عمداً بدون ‎# syntax=docker/dockerfile:1‎ — frontend داخلی BuildKit کافی است؛
# دلیل در Dockerfile.collector.)
#
#   docker build --platform linux/amd64 -f Dockerfile.web -t tablo-web:v1 .
#
# context = ریشه‌ی مخزن (فیلترشده با ‎.dockerignore‎ ریشه).
#
# اپ TanStack Start + Nitro است، نه نکست: ‎vite build‎ پوشه‌ی ‎.output‎ می‌سازد
# که «خودبسنده» است — همه‌ی وابستگی‌ها (ioredis، pg، ری‌اکت) داخلش باندل شده و
# مرحله‌ی اجرا هیچ ‎node_modules‎ ای لازم ندارد. راستی‌آزمایی شد: کپی تنها
# ‎.output‎ به یک پوشه‌ی خالی و ‎node .output/server/index.mjs‎ ⟸ ۲۰۰.
#
# ⚠️ حافظه/پردازنده: ‎vite build‎ به‌راحتی >1GB رم می‌خواهد. سرور تولید ۱ هسته و
# ۲GB رم مشترک با پادل‌یار دارد (بند ۱۳ سند معماری، تصمیم ۵) — پس ساخت این
# ایمیج «همیشه» در CI یا روی لپ‌تاپ انجام می‌شود (‎--platform linux/amd64‎)،
# هرگز روی سرور. سرور فقط ‎docker load/pull‎ و ‎compose up‎ می‌کند.

########## مرحله‌ی وابستگی‌ها ##########
FROM node:22-alpine AS deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
# npm ci: نصب بازتولیدپذیر دقیقاً از lock — شامل devDependencies، چون
# ‎vite‎/‎nitro‎/‎typescript‎ برای ساخت لازم‌اند. NODE_ENV اینجا عمداً production
# نیست، وگرنه npm اصلاً devDependencies را نصب نمی‌کند و ساخت می‌شکند.
RUN npm ci --no-audit --no-fund

########## مرحله‌ی ساخت ##########
FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
RUN npm run build

# دو دروازه‌ی صریح — بهتر است ساخت اینجا با پیام روشن بشکند تا اینکه ایمیج
# ناقص یا با هدف اشتباه به سرور برسد:
#
#   ۱) خروجی سرور نود باید وجود داشته باشد.
#   ۲) پریست باید ‎node-server‎ باشد. پیش‌فرض تاریخی این استک
#      ‎cloudflare-module‎ بوده که نه ioredis در آن کار می‌کند نه pg؛ اگر روزی
#      ‎web/vite.config.ts‎ دست بخورد و پریست برگردد، اینجا لو می‌رود.
RUN test -f .output/server/index.mjs || { \
      echo "ERROR: .output/server/index.mjs ساخته نشد — خروجی nitro خالی است"; \
      exit 1; }
RUN grep -q '"preset": "node-server"' .output/nitro.json || { \
      echo "ERROR: پریست nitro برابر node-server نیست."; \
      echo "       nitro({ preset: \"node-server\" }) در web/vite.config.ts لازم است."; \
      cat .output/nitro.json; \
      exit 1; }

########## مرحله‌ی اجرا: فقط ‎.output‎ روی ایمیج لاغر ##########
FROM node:22-alpine AS runtime
WORKDIR /app

# HOST=0.0.0.0 لازم است: کدیِ لبه از شبکه‌ی tablo-edge به این کانتینر وصل
# می‌شود، پس گوش‌دادن روی loopback کافی نیست.
#
# ‎--max-old-space-size=192‎ عمدی و مهم است: V8 سقف heap خود را از رم «میزبان»
# حدس می‌زند نه از سقف cgroup کانتینر. بدون این پرچم، یک نشتی یا یک بار سنگین
# می‌تواند تا نزدیک ۲GB رشد کند و OOM-killer به‌جای این پروسه، کانتینر پادل‌یار
# را بکشد. این عدد جفتِ ‎memory: 256M‎ در compose.prod.yml است (کمی زیر آن، تا
# V8 زودتر GC کند و پیش از cgroup به سقف بخورد) — هر کدام عوض شد، دیگری هم.
# اندازه‌گیری واقعی: ۶۱MB پس از ۲۰۰ درخواست SSR در کانتینر ۲۵۶MB.
ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0 \
    NODE_OPTIONS=--max-old-space-size=192

# ‎.output‎ خودبسنده است — نه ‎node_modules‎، نه ‎package.json‎، نه کد منبع.
# مالکیت node:node چون پروسه با کاربر غیر-root اجرا می‌شود.
COPY --from=build --chown=node:node /app/.output ./.output

USER node
EXPOSE 3000

# صفحه‌ی اصلی طبق طراحی «همیشه ۲۰۰» است (قاعده‌ی ۵ قراردادها) — قطع ردیس یا
# پستگرس کهنگی است نه خطا. پس شکست این چک یعنی خود پروسه‌ی وب مشکل دارد.
HEALTHCHECK --interval=60s --timeout=10s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3000/').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", ".output/server/index.mjs"]
