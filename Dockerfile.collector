# Dockerfile.collector — ایمیج تولید گردآورنده (بلیت ۱۱)
#
# (عمداً بدون ‎# syntax=docker/dockerfile:1‎ — frontend داخلی BuildKit کافی است
# و directive خارجی یعنی یک pull اضافه از Docker Hub که روی شبکه‌های محدود
# — از جمله دسترسی ایران به هاب — ساخت را می‌شکند/کند می‌کند.)
#
#   docker build -f Dockerfile.collector -t mazane-collector .
#
# context = ریشه‌ی مخزن (فیلترشده با ‎.dockerignore‎ ریشه).
# ساخت «بیرون از سرور» انجام می‌شود (CI یا لپ‌تاپ با ‎--platform linux/amd64‎)؛
# سرور ۱ هسته/۲GB فقط ایمیج آماده را اجرا می‌کند (بند ۱۳ سند معماری، تصمیم ۵).

########## مرحله‌ی ساخت: نصب پکیج در venv ایزوله ##########
FROM python:3.12-slim AS build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN python -m venv /opt/venv

WORKDIR /src
COPY collector/pyproject.toml ./pyproject.toml
COPY collector/src ./src
# نصب غیرقابل‌ویرایش (نه ‎-e‎): venv خودکفا می‌شود و تنها چیزی است که به
# مرحله‌ی اجرا می‌رود — بدون setuptools cache و بدون سورس اضافه.
RUN /opt/venv/bin/pip install .

########## مرحله‌ی اجرا: فقط venv + healthcheck ##########
FROM python:3.12-slim

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

COPY --from=build /opt/venv /opt/venv
COPY ops/collector-healthcheck.py /app/healthcheck.py

# کاربر غیر root — گردآورنده هیچ‌چیزی روی دیسک نمی‌نویسد
RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin mazane
USER mazane

# healthcheck: ردیس در دسترس + تازه‌ترین ‎mazane:updated_at:*‎ جوان‌تر از آستانه.
# منطق و توجیهش (سازگاری با «کهنگی، نه خطا») داخل خود اسکریپت مستند است.
# start-period سخاوتمندانه: اولین نوبت گردآوری باید کامل شود.
HEALTHCHECK --interval=60s --timeout=15s --start-period=120s --retries=5 \
    CMD ["python", "/app/healthcheck.py"]

# پیکربندی با متغیرهای محیطی (MAZANE_REDIS_URL، MAZANE_DATABASE_URL،
# MAZANE_REVALIDATE_URL/TOKEN، MAZANE_DAILY_PUBLISH_CAP) — از compose می‌آیند.
CMD ["mazane-collector"]
